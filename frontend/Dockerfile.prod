# ============================================
# TravelMind Frontend - Production Dockerfile
# ============================================
# Multi-stage build with nginx for static file serving
# Optimized for production with gzip compression

# ============================================
# Stage 1: Build
# ============================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files first for better caching
COPY package*.json ./

# Install dependencies (including dev dependencies for build)
RUN npm ci

# Copy source code
COPY . .

# Build for production
RUN npm run build

# ============================================
# Stage 2: Production with nginx
# ============================================
FROM nginx:alpine AS production

# Labels
LABEL org.opencontainers.image.title="TravelMind Frontend"
LABEL org.opencontainers.image.description="Self-hosted travel planning app frontend"
LABEL org.opencontainers.image.version="1.0.0"
LABEL org.opencontainers.image.source="https://github.com/your-repo/TravelMind"

# Create non-root user for nginx
RUN addgroup -g 1001 -S travelmind && \
    adduser -u 1001 -S travelmind -G travelmind

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Create nginx pid and cache directories with proper permissions
RUN mkdir -p /var/cache/nginx /var/run && \
    chown -R travelmind:travelmind /var/cache/nginx /var/run /usr/share/nginx/html && \
    chmod -R 755 /var/cache/nginx

# Remove default nginx config
RUN rm -f /etc/nginx/conf.d/default.conf

# Switch to non-root user. nginx.conf hoert deshalb auf 8080 (Ports < 1024 sind
# einem unprivilegierten Prozess verwehrt) und schreibt seine PID nach /tmp.
# Numerisch, nicht als Name — siehe backend/Dockerfile.prod.
USER 1001:1001

# Expose port
EXPOSE 8080

# Shell-Form ist hier noetig: der HEALTHCHECK verkettet mit "||" bzw. nutzt
# eine Shell-Auswertung. In JSON-Notation gaebe es keine Verkettung.
# Health check — use 127.0.0.1 (nginx listens IPv4-only; "localhost" resolves to
# IPv6 ::1 in this image and would false-fail) with busybox-compatible wget flags.
# hadolint ignore=DL3025
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
