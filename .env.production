# Production Environment Configuration for TravelMind
# This file is used when deploying to https://reise.chicohaager.de

# Backend API URL - use relative path when nginx proxies
VITE_API_URL=

# Database (PostgreSQL)
DATABASE_URL=postgresql://travelmind:travelmind@db:5432/travelmind

# Security
JWT_SECRET=change-me-jwt-secret
SECRET_KEY=change-me-secret-key

# CORS - Allow production domain
CORS_ORIGINS=https://reise.chicohaager.de,http://reise.chicohaager.de

# PostgreSQL
POSTGRES_USER=travelmind
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=travelmind

# Logging
LOG_LEVEL=WARNING

# Production mode
NODE_ENV=production
BACKEND_RELOAD=false
